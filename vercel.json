{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build && rm -rf ../public && mkdir -p ../public && cp -r dist/. ../public/",
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,demo-projects/**,sample-project/**,extension/**,frontend/node_modules/**,frontend/src/**,.pytest_cache/**}"
    }
  },
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/webview", "destination": "/index.html" }
  ]
}
